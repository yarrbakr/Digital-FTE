# Digital FTE — backend configuration
# Copy to `.env` and fill in. Everything has a default except the LLM API key.

# --- AI provider (bring-your-own; Mistral's free key keeps this at $0) ---
# Get a free key at https://console.mistral.ai/
LLM_PROVIDER=mistral
LLM_API_KEY=
LLM_MODEL=mistral-small-latest

# --- Database (embedded SQLite by default; no external service needed) ---
DATABASE_URL=sqlite:///./digital_fte.db

# --- Encryption key for stored channel/provider credentials ---
# Leave blank to auto-generate on first run, or set a stable 32+ char secret.
SECRET_KEY=

# --- Pipeline ---
POLL_INTERVAL_SECONDS=120
PRIORITY_KEYWORDS=urgent,asap,immediately,important,deadline,critical,emergency,payment,invoice,contract,signature required

# --- App ---
DEBUG=false
