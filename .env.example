# Example Environment Configuration
# Copy this file to .env and fill in your actual values

# Path to your Obsidian vault
VAULT_PATH=/path/to/your/AI_Employee_Vault

# Gmail API credentials file path
GMAIL_CREDENTIALS=./credentials.json

# How often to check Gmail (seconds)
CHECK_INTERVAL=120

# How often the MCP trigger checks /Approved (seconds)
MCP_CHECK_INTERVAL=10

# Optional: Custom skill path
# SKILL_PATH=/path/to/custom/skill.md

# LinkedIn credentials (for Playwright-based posting)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password
LINKEDIN_SESSION_PATH=./.linkedin-session

# WhatsApp Watcher - persistent browser session directory
WHATSAPP_SESSION_PATH=./.whatsapp-session
WHATSAPP_CHECK_INTERVAL=180